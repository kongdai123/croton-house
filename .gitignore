# generated / heavy / re-downloadable
web/node_modules/
web/dist/
web/build/
# commercial album track; not published
web/assets/audio/brush-i.m4a
.DS_Store
__pycache__/
# screenshots and comparison sheets (large; kept locally, linked from docs/reports)
docs/evidence/
# fidelity-check and pet test output (regenerate with web/tools/compare.py and the pet tools)
compare/
# promo renders (remake with web/tools/promo.mjs + promo_encode.py)
docs/promo/*.mp4
# baked-lighting pipeline: Slurm wrappers for one particular cluster, and the bake outputs
bake/cluster/
bake/work/
# the shader link test's page bundle and report (web/tools/shader_link_test.mjs)
web/tools/out/
# bake QA output (bake/validate/qa.py writes qa.json and qa.txt into the working directory by default)
/qa.json
/qa.txt
# UI smoke run output (web/tools/smoke/run.mjs --out)
web/smoke-artifacts/
# agent worktrees and notes that must never be committed (cluster hosts and paths live in them)
.claude/
bake/AGENTS_BRIEF.md
bake/INTEGRATION_TODO.md
# also a symlinked node_modules (a worktree's link to the main checkout's), which the directory pattern above misses
web/node_modules
